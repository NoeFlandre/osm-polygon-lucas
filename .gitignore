# Publish only the maintained package, docs, tests, and build configuration.
/*
!/.gitignore
!/.python-version
!/README.md
!/Dockerfile
!/MANIFEST.in
!/mkdocs.yml
!/pyproject.toml
!/uv.lock
!/config/
!/docs/
!/src/
!/tests/
!/.github/

# Local environments, generated files, source data, and scratch work.
**/.DS_Store
**/__pycache__/
*.py[cod]
**/.venv/
**/.pytest_cache/
**/.hypothesis/
**/.ruff_cache/
**/*.egg-info/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/
data/
mutants/
.mutmut-cache
.work/
.review-baseline/
.claude/
