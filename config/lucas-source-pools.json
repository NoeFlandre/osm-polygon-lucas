    "sampling": {
      "method": "H3",
      "resolution": 3,
      "seed": 42,
      "maximum_per_cell": 20,
      "run_after_eligibility_counts": true
    }
  },
  "eligibility": {
    "support_geometry_crs": "EPSG:3035",
    "source_geometry_crs": "OGC:CRS84",
    "projection": "OGC:CRS84 to EPSG:3035 with always_xy=True",
    "coverage_level": "main_category",
    "minimum_class_fraction": 0.8,
    "denominator": "full original OSM polygon area after projection; uncovered area remains in denominator",
    "eligible": "exactly one mapped main_category covers at least 80% of the full original projected polygon area",
    "excluded_coverage_outcomes": [
      "below_threshold",
      "ambiguous",
      "unknown_unmapped_support",
      "no_overlap",
      "boundary_only"
    ],
    "excluded_geometry_outcomes": [
      "invalid_wkb",
      "invalid_geojson",
      "non_polygon_geometry",
      "outside_crs84_bounds",
      "invalid_geometry",
      "zero_area",
      "invalid_after_projection",
      "zero_area_after_projection"
    ],
    "excluded_label_statuses": [
      "failed",
      "skipped"
    ],
    "uncovered_polygons_are_negative": false
  },
  "sources": {
    "Description": {
      "source_id": "description",
      "input_repository": "NoeFlandre/osm-polygon-description-tag",
      "input_revision": "b4706eb315c66a8a57135289e7612dca8e03caf8",
      "label_repository": "NoeFlandre/osm-polygon-description-tag-landuse",
      "label_revision": "ce98b328f3c6543800a3d931877b51eb3f0cf768",
      "geometry_encoding": "wkb",
      "direct_input": {
        "schema": "description-language-v1",
        "polygon_path_template": "data/{region}-latest.parquet",
        "text_path_template": "language-v1/data/{region}-latest.parquet"
      },
      "join_key_fields": [
        "description_identity",
        "tag_key",
        "sentence_index"
      ],
      "streams": [
        {
          "name": "description",
          "labels_path_template": "labels/language-v1/data/{region}-latest.parquet"
        }
      ]
    },
    "Website": {
      "source_id": "website",
      "input_repository": "NoeFlandre/osm-polygon-website-tag",
      "input_revision": "4cbddf95ce614e68d5ada8b94ca21bf9e48d39dd",
      "label_repository": "NoeFlandre/osm-polygon-website-tag-landuse",
      "label_revision": "e6524c711ee0033c3cd5990e5fdbbe4b89992dfb",
      "geometry_encoding": "geojson",
      "direct_input": {
        "schema": "website-polygons-v1",
        "polygon_path_template": "polygons/{region}-latest.parquet",
        "text_path_template": "polygons/{region}-latest.parquet",
        "sentence_count_fields": {
          "website": "website_sentence_count",
          "contact_website": "contact_website_sentence_count"
        }
      },
      "join_key_fields": [
        "polygon_id",
        "field",
        "sentence_index"
      ],
      "streams": [
        {
          "name": "website",
          "labels_path_template": "labels/polygons/{region}-latest.parquet"
        }
      ]
    },
    "Wikidata": {
      "source_id": "wiki",
      "display_label": "Wikidata/Wikipedia source; Atlas labels both Wikipedia and Wikivoyage sentence streams",
      "input_repository": "NoeFlandre/osm-polygon-wikidata-and-wikipedia",
      "input_revision": "d6fc058ccf4643bc5fe5bfd5c1c0bc403d3da801",
      "label_repository": "NoeFlandre/osm-polygon-wikidata-and-wikipedia-landuse",
      "label_revision": "49307aeb05b6dcc8a5d393f77f59a1e6d13a967a",
      "geometry_encoding": "geojson",
      "direct_input": {
        "schema": "wiki-document-sentences-v1",
        "polygon_path_template": "polygons/{region}-latest.parquet",
        "links_path_template": "polygon_document_links/{region}-latest.parquet"
      },
      "join_key_fields": [
        "sentence_id"
      ],
      "streams": [
        {
          "name": "wikipedia",
          "text_path_template": "{stream}/sentences/{region}-latest.parquet",
          "labels_path_template": "labels/wikipedia/sentences/{region}-latest.parquet"
        },
        {
          "name": "wikivoyage",
          "text_path_template": "{stream}/sentences/{region}-latest.parquet",
          "labels_path_template": "labels/wikivoyage/sentences/{region}-latest.parquet"
        }
      ]
    }
  }
}
